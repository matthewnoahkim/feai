{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "feai.app" }],
      "destination": "https://www.feai.app/:path*",
      "permanent": true
    }
  ]
}
