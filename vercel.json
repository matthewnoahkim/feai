{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "installCommand": "npm install",
  "builds": [
    {
      "src": "packages/backend/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["packages/backend/prisma/**", "packages/frontend/dist/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "packages/backend/src/index.ts"
    }
  ]
}
