{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "packages/backend/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "packages/backend/src/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
