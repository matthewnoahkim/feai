{
  "name": "@feai/backend",
  "version": "1.0.0",
  "description": "feai REST API Server",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && node ../../node_modules/typescript/bin/tsc",
    "dev": "node ../../node_modules/ts-node-dev/lib/bin.js --respawn src/index.ts",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@feai/shared": "^1.0.0",
    "@feai/kernel": "^1.0.0",
    "@prisma/client": "^5.7.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "uuid": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "google-auth-library": "^9.4.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7",
    "@types/multer": "^1.4.11",
    "@types/jsonwebtoken": "^9.0.5",
    "prisma": "^5.7.1",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0"
  }
}

