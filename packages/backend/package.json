{
  "name": "@feai/backend",
  "version": "1.0.0",
  "description": "feai Unified Server - REST API + Static Frontend",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && node ../../node_modules/typescript/bin/tsc",
    "dev": "node ../../node_modules/ts-node-dev/lib/bin.js --respawn src/index.ts",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push:local": "dotenv -e ../../.env -- prisma db push",
    "db:migrate:local": "dotenv -e ../../.env -- prisma migrate dev",
    "db:studio:local": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@feai/kernel": "^1.0.0",
    "@feai/shared": "^1.0.0",
    "@prisma/client": "^5.7.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express-session": "^1.18.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "google-auth-library": "^9.4.1",
    "googleapis": "^169.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "prisma": "^5.7.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
