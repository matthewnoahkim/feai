{
  "name": "feai",
  "version": "1.0.0",
  "private": true,
  "description": "Web-based CAD Software with REST API",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:frontend && npm run dev:server",
    "dev:server": "npm run dev -w @feai/backend",
    "build": "npm run db:generate && npm run build:frontend && npm run build:server",
    "build:frontend": "npm run build -w @feai/shared && npm run build -w @feai/kernel && npm run build -w @feai/frontend",
    "build:server": "npm run build -w @feai/backend",
    "start": "npm run build && npm start -w @feai/backend",
    "db:push": "npm run db:push:local -w @feai/backend",
    "db:generate": "npm run db:generate -w @feai/backend",
    "db:studio": "npm run db:studio:local -w @feai/backend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "node ./node_modules/rimraf/dist/esm/bin.mjs packages/*/dist packages/*/.turbo node_modules/.cache",
    "vercel-build": "npm run db:generate && npm run build:frontend && npm run build:server"
  },
  "dependencies": {
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "ts-node-dev": "^2.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv-cli": "^11.0.0",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/feai/feai.git"
  },
  "license": "MIT"
}
